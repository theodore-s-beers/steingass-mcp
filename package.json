{
  "name": "steingass-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Steingass Persian-English dictionary",
  "keywords": [
    "dictionary",
    "mcp",
    "persian",
    "steingass"
  ],
  "license": "MIT",
  "author": "Theodore Beers",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "check": "pnpm run lint && pnpm run format:check && pnpm test",
    "dev": "node --watch main.js",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "start": "node main.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0"
  },
  "engines": {
    "node": ">=24"
  }
}
